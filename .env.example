# Any long random string. n8n encrypts stored credentials with it.
N8N_ENCRYPTION_KEY=
# The secret for the "run now" and setup webhooks (header X-Newsletter-Key).
NEWSLETTER_KEY=
# The model API: any address that speaks the OpenAI chat completions format.
MODEL_BASE_URL=https://api.openai.com/v1
MODEL=gpt-4o-mini
MODEL_API_KEY=
# The draft: who gets it, who it is from, what the newsletter is called.
TO_EMAIL=you@example.com
FROM_EMAIL=newsletter@example.com
NEWSLETTER_NAME=This week in town
# Your mail server.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
# Time zone for "Monday 07:00" and for what counts as today.
GENERIC_TIMEZONE=UTC
# Port of the n8n editor on this machine.
N8N_PORT=5678
